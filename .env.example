# 应用基础配置
# 应用名称，用于日志、监控和服务标识
APP_NAME=etl-agent
# 运行环境：development、test 或 production
APP_ENV=development
# 日志级别：DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO
# API 服务监听地址；0.0.0.0 表示监听所有网卡
API_HOST=0.0.0.0
# API 服务监听端口
API_PORT=8000
# 前端访问控制面服务的基础地址
FRONTEND_API_BASE_URL=http://localhost:8000
# Vite 前端调用后端 API 的地址
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 允许跨域访问的前端地址，多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173
# Docker Compose 端口绑定地址；远程访问时可改为 0.0.0.0，并配置防火墙
COMPOSE_BIND_IP=127.0.0.1

# PostgreSQL 控制面数据库与 LangGraph Checkpoint 配置
# 应用使用的异步 SQLAlchemy 数据库连接串
DATABASE_URL=postgresql+asyncpg://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# 应用使用的同步 psycopg 数据库连接串
DATABASE_SYNC_URL=postgresql+psycopg://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# LangGraph PostgreSQL Checkpoint 使用的标准 psycopg 连接串
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# PostgreSQL 服务主机名或 IP 地址
POSTGRES_HOST=localhost
# PostgreSQL 服务端口
POSTGRES_PORT=5432
# PostgreSQL 数据库名称
POSTGRES_DB=etl_agent
# PostgreSQL 登录用户名
POSTGRES_USER=etl_agent
# PostgreSQL 登录密码；共享或生产环境必须替换
POSTGRES_PASSWORD=etl_agent_dev

# Redis、Celery 和 Replay Guard 配置
# Redis 通用连接串
REDIS_URL=redis://localhost:6379/0
# Celery Broker 消息队列连接串
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery 任务结果后端连接串
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Capability Replay Guard 使用的 Redis 逻辑库连接串
REPLAY_GUARD_REDIS_URL=redis://localhost:6379/3

# MinIO / S3 兼容对象存储配置
# 对象存储后端类型
OBJECT_STORAGE_BACKEND=minio
# MinIO API 地址；Compose 内应用应使用 http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
# MinIO 访问用户名；生产环境必须使用独立账号
MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密码；生产环境必须替换
MINIO_SECRET_KEY=minioadmin
# S3 区域标识
MINIO_REGION=us-east-1
# 保存文件资产、制品和 Benchmark 结果的 bucket
MINIO_BUCKET=etl-agent
# 是否使用 HTTPS 访问 MinIO：true 或 false
MINIO_SECURE=false
# 当对象存储不可用时的本地文件存储目录
LOCAL_FILE_STORAGE_PATH=./var/files

# SecretProvider / HashiCorp Vault KV v2 配置
# SecretProvider 实现；首期使用 vault
SECRET_PROVIDER=vault
# Vault 服务地址
VAULT_ADDR=http://localhost:8200
# Vault 开发模式 Token；共享或生产环境必须替换
VAULT_TOKEN=dev-only-token
# Vault Enterprise namespace；非 Enterprise 环境留空
VAULT_NAMESPACE=
# Vault KV v2 mount 名称
VAULT_KV_MOUNT=secret
# ETL-Agent 在 KV mount 下使用的路径前缀
VAULT_KV_PREFIX=etl-agent

# JWT 身份认证配置
# JWT 签名密钥；必须使用随机高强度密钥，禁止提交真实值
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
# JWT 签名算法
JWT_ALGORITHM=HS256
# Access Token 有效期，单位为分钟
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ed25519 Capability 签名配置
# Ed25519 私钥文件路径；文件应放在被忽略的 secrets/ 目录
CAPABILITY_PRIVATE_KEY_PATH=./secrets/capability_ed25519_private.pem
# Ed25519 公钥文件路径
CAPABILITY_PUBLIC_KEY_PATH=./secrets/capability_ed25519_public.pem
# Capability 令牌有效期，单位为秒；需求默认值为 5 分钟
CAPABILITY_TTL_SECONDS=300
# Replay Guard 保留单次消费记录的时间，单位为秒
REPLAY_GUARD_TTL_SECONDS=300

# 远端 LLM Provider 配置（不在本地或 VM 部署模型）
# Provider 类型；openai_compatible 表示使用 OpenAI 兼容接口
LLM_PROVIDER=openai_compatible
# 百炼 OpenAI 兼容 API 的 Base URL，请按实际区域和平台配置修改
LLM_BASE_URL=https://api.openai.com/v1
# LLM API Key；禁止提交真实密钥或写入日志
LLM_API_KEY=replace-with-provider-api-key
# 使用的模型名称
LLM_MODEL=replace-with-model-name
# 单次 LLM 请求超时时间，单位为秒
LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM 请求失败时的最大重试次数
LLM_MAX_RETRIES=2
# DeepSeek 兼容 API 地址（备用 Provider）
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# DeepSeek API Key；不使用时留空
DEEPSEEK_API_KEY=
# Qwen/通义千问兼容 API 地址（备用 Provider）
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen API Key；不使用时留空
QWEN_API_KEY=

# Celery Worker 和 SeaTunnel 数据面配置
# Celery 默认任务队列名称
CELERY_TASK_DEFAULT_QUEUE=etl-agent
# Celery Worker 并发数，应结合 VM CPU 和任务类型调整
CELERY_WORKER_CONCURRENCY=4
# SeaTunnel 执行模式；zeta 表示使用 Zeta 集群
SEATUNNEL_EXECUTION_MODE=zeta
# SeaTunnel 安装目录；容器内或本机部署时按实际路径填写
SEATUNNEL_HOME=
# SeaTunnel Zeta 服务地址
SEATUNNEL_ZETA_ENDPOINT=http://localhost:5801
# SeaTunnel 配置文件目录
SEATUNNEL_CONFIG_DIR=./seatunnel/config
# SeaTunnel 作业最大执行时间，单位为秒
SEATUNNEL_JOB_TIMEOUT_SECONDS=3600

# 文件上传、质量契约和运行监督默认值
# 单个上传文件最大大小，单位为字节（1 GiB）
MAX_UPLOAD_SIZE_BYTES=1073741824
# 默认最大读取记录数
DEFAULT_MAX_INPUT_RECORDS=10000000
# 默认最大写入字节数（10 GiB）
DEFAULT_MAX_OUTPUT_BYTES=10737418240
# 默认最大执行时长，单位为秒
DEFAULT_MAX_RUNTIME_SECONDS=3600
# 默认最大输出放大比
DEFAULT_MAX_OUTPUT_AMPLIFICATION=10
# 默认最大错误拒绝率，超过后触发监督策略
DEFAULT_MAX_REJECTION_RATE=0.05
# Benchmark 数据集目录
BENCHMARK_DATASET_PATH=./benchmarks
