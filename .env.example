# 应用基础配置
# 应用名称，用于日志、监控和服务标识
APP_NAME=etl-agent
# 运行环境：development、test 或 production
APP_ENV=development
# 日志级别：DEBUG、INFO、WARNING、ERROR
LOG_LEVEL=INFO
# API 服务监听地址；0.0.0.0 表示监听所有网卡
API_HOST=0.0.0.0
# API 服务监听端口
API_PORT=8000
# 前端访问控制面服务的基础地址
FRONTEND_API_BASE_URL=http://localhost:8000
# Vite 前端调用后端 API 的地址
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 允许跨域访问的前端地址，多个地址用逗号分隔
CORS_ORIGINS=http://localhost:5173
# Docker Compose 端口绑定地址；远程访问时可改为 0.0.0.0，并配置防火墙
COMPOSE_BIND_IP=127.0.0.1

# PostgreSQL 控制面数据库与 LangGraph Checkpoint 配置
# 应用使用的异步 SQLAlchemy 数据库连接串
DATABASE_URL=postgresql+asyncpg://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# 应用使用的同步 psycopg 数据库连接串
DATABASE_SYNC_URL=postgresql+psycopg://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# LangGraph PostgreSQL Checkpoint 使用的标准 psycopg 连接串
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://etl_agent:etl_agent_dev@localhost:5432/etl_agent
# PostgreSQL 服务主机名或 IP 地址
POSTGRES_HOST=localhost
# PostgreSQL 服务端口
POSTGRES_PORT=5432
# PostgreSQL 数据库名称
POSTGRES_DB=etl_agent
# PostgreSQL 登录用户名
POSTGRES_USER=etl_agent
# PostgreSQL 登录密码；共享或生产环境必须替换
POSTGRES_PASSWORD=etl_agent_dev

# Redis、Celery 和 Replay Guard 配置
# Redis 通用连接串
REDIS_URL=redis://localhost:6379/0
# Celery Broker 消息队列连接串
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery 任务结果后端连接串
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Capability Replay Guard 使用的 Redis 逻辑库连接串
REPLAY_GUARD_REDIS_URL=redis://localhost:6379/3

# MinIO / S3 兼容对象存储配置
# 对象存储后端类型
OBJECT_STORAGE_BACKEND=minio
# MinIO API 地址；Compose 内应用应使用 http://minio:9000
MINIO_ENDPOINT=http://localhost:9000
# MinIO 访问用户名；生产环境必须使用独立账号
MINIO_ACCESS_KEY=minioadmin
# MinIO 访问密码；生产环境必须替换
MINIO_SECRET_KEY=minioadmin
# S3 区域标识
MINIO_REGION=us-east-1
# 保存文件资产、制品和 Benchmark 结果的 bucket
MINIO_BUCKET=etl-agent
# 是否使用 HTTPS 访问 MinIO：true 或 false
MINIO_SECURE=false
# 当对象存储不可用时的本地文件存储目录
LOCAL_FILE_STORAGE_PATH=./var/files

# SecretProvider / HashiCorp Vault KV v2 配置
# SecretProvider 实现；首期使用 vault
SECRET_PROVIDER=vault
# Vault 服务地址
VAULT_ADDR=http://localhost:8200
# Vault 开发模式 Token；共享或生产环境必须替换
VAULT_TOKEN=dev-only-token
# Vault Enterprise namespace；非 Enterprise 环境留空
VAULT_NAMESPACE=
# Vault KV v2 mount 名称
VAULT_KV_MOUNT=secret
# ETL-Agent 在 KV mount 下使用的路径前缀
VAULT_KV_PREFIX=etl-agent

# JWT 身份认证配置
# JWT 签名密钥；必须使用随机高强度密钥，禁止提交真实值
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret
# JWT 签名算法
JWT_ALGORITHM=HS256
# Access Token 有效期，单位为分钟
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Ed25519 Capability 签名配置
# Ed25519 私钥文件路径；文件应放在被忽略的 secrets/ 目录
CAPABILITY_PRIVATE_KEY_PATH=./secrets/capability_ed25519_private.pem
# Ed25519 公钥文件路径
CAPABILITY_PUBLIC_KEY_PATH=./secrets/capability_ed25519_public.pem
# Capability 令牌有效期，单位为秒；需求默认值为 5 分钟
CAPABILITY_TTL_SECONDS=300
# Replay Guard 保留单次消费记录的时间，单位为秒
REPLAY_GUARD_TTL_SECONDS=300

# 远端 LLM Provider 配置（不在本地或 VM 部署模型）
# Provider 类型；openai_compatible 表示使用 OpenAI 兼容接口
LLM_PROVIDER=openai_compatible
# 百炼 OpenAI 兼容 API 的 Base URL，请按实际区域和平台配置修改
LLM_BASE_URL=https://api.openai.com/v1
# LLM API Key；禁止提交真实密钥或写入日志
LLM_API_KEY=replace-with-provider-api-key
# 使用的模型名称
LLM_MODEL=replace-with-model-name
# 单次 LLM 请求超时时间，单位为秒
LLM_REQUEST_TIMEOUT_SECONDS=60
# LLM 请求失败时的最大重试次数
LLM_MAX_RETRIES=2
# 发送到远端 LLM 的脱敏 Prompt 最大字节数，防止 Profile 意外过大
LLM_MAX_PROMPT_BYTES=100000
# 是否允许执行真实百炼 smoke test；默认关闭，开启前必须使用非生产密钥和脱敏数据
LLM_REAL_SMOKE_ENABLED=false
# 是否允许执行 VM PostgreSQL Checkpoint 集成测试；默认关闭
CHECKPOINT_INTEGRATION_ENABLED=false

# Prepare 阶段事实的有效期，单位为秒；过期后必须重新 Prepare
PREPARATION_TTL_SECONDS=300
# DeepSeek 兼容 API 地址（备用 Provider）
DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1
# DeepSeek API Key；不使用时留空
DEEPSEEK_API_KEY=
# Qwen/通义千问兼容 API 地址（备用 Provider）
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Qwen API Key；不使用时留空
QWEN_API_KEY=

# Celery Worker 和 SeaTunnel 数据面配置
# Celery 默认任务队列名称
CELERY_TASK_DEFAULT_QUEUE=etl-agent
# Celery Worker 并发数，应结合 VM CPU 和任务类型调整
CELERY_WORKER_CONCURRENCY=4
# Celery Beat 检查 Transactional Outbox 的间隔，单位为秒
OUTBOX_POLL_INTERVAL_SECONDS=5
# SeaTunnel 执行模式；zeta 表示使用 Zeta 集群
SEATUNNEL_EXECUTION_MODE=zeta
# 开启 Hazelcast REST API；SeaTunnel 2.3.10 默认关闭，适配器联调必须开启
HZ_NETWORK_RESTAPI_ENABLED=true
# SeaTunnel 安装目录；容器内或本机部署时按实际路径填写
SEATUNNEL_HOME=
# SeaTunnel Zeta 服务地址
SEATUNNEL_ZETA_ENDPOINT=http://localhost:5802
# 是否启用真实合成 MySQL -> Doris 数据面；关闭时只运行控制面或 Fake 测试
REAL_DATA_PLANE_ENABLED=false
# SeaTunnel 容器访问 Compose 内 MySQL 的服务名
SEATUNNEL_MYSQL_HOST=mysql
# SeaTunnel 容器访问 Doris FE Stream Load 的服务名和端口
SEATUNNEL_DORIS_FENODES=doris-fe:8030
# SeaTunnel 作业提交接口路径；M5 Adapter 通过此路径隔离 Zeta API 变化
SEATUNNEL_SUBMIT_PATH=/submit-job
# SeaTunnel 作业提交格式；2.3.10 真实 REST 接口使用 hocon
SEATUNNEL_SUBMIT_FORMAT=hocon
# SeaTunnel 作业状态查询路径；{job_id} 会替换为引擎返回的作业 ID
SEATUNNEL_STATUS_PATH=/job-info/{job_id}
# SeaTunnel 作业取消路径；{job_id} 会替换为引擎返回的作业 ID
# SeaTunnel 取消接口；2.3.10 使用 POST /stop-job 并在 JSON 体中传 jobId
SEATUNNEL_CANCEL_PATH=/stop-job
# SeaTunnel 影子表和错误表清理路径；需按实际 Zeta API 覆盖
SEATUNNEL_CLEANUP_PATH=/jobs/{job_id}/cleanup
# SeaTunnel 质量通过后的目标表原子切换路径；需按实际目标适配器覆盖
SEATUNNEL_SWAP_PATH=/jobs/{job_id}/swap
# SeaTunnel 失败后的目标表回滚路径；需按实际目标适配器覆盖
SEATUNNEL_ROLLBACK_PATH=/jobs/{job_id}/rollback
# SeaTunnel 配置文件目录
SEATUNNEL_CONFIG_DIR=./seatunnel/config
# SeaTunnel 作业最大执行时间，单位为秒
SEATUNNEL_JOB_TIMEOUT_SECONDS=3600

# 可选的 MySQL/Doris 合成数据面（使用 source-target Compose profile）
# MySQL 镜像版本；与 SeaTunnel 2.3.10 JDBC 连接器先采用 8.0.x 保守基线
MYSQL_IMAGE=mysql:8.0.36
# MySQL 对宿主机暴露端口
MYSQL_PORT=3306
# 合成源库名称
SOURCE_MYSQL_DATABASE=etl_demo
# 合成源库业务用户
SOURCE_MYSQL_USER=etl_demo
# 合成源库业务用户密码；仅用于本地开发，生产必须改用 Vault
SOURCE_MYSQL_PASSWORD=etl_demo_dev
# 合成源库 root 密码；仅用于本地开发
SOURCE_MYSQL_ROOT_PASSWORD=root_dev_only
# Doris FE 镜像；FE/BE 必须保持同一 Doris 版本
DORIS_FE_IMAGE=apache/doris:fe-2.1.11
# Doris BE 镜像；FE/BE 必须保持同一 Doris 版本
DORIS_BE_IMAGE=apache/doris:be-2.1.11
# Doris FE HTTP 管理端口
DORIS_FE_HTTP_PORT=8030
# Doris FE MySQL 协议查询端口
DORIS_FE_QUERY_PORT=9030
# Doris BE HTTP 管理端口
DORIS_BE_HTTP_PORT=8040
# Doris 单节点 FE 静态地址；用于 FE_SERVERS 集群发现
DORIS_FE_IP=172.30.0.10
# Doris 单节点 BE 静态地址；用于 BE_ADDR 注册
DORIS_BE_IP=172.30.0.11
# Doris FE 集群发现字符串；2.1.x 镜像要求使用 IP:编辑日志端口格式
DORIS_FE_SERVERS=fe1:172.30.0.10:9010
# Doris BE 心跳地址；必须与 DORIS_BE_IP 和 9050 端口一致
DORIS_BE_ADDR=172.30.0.11:9050
# Doris 内部 Docker 网络；如与现有 Docker 网段冲突需整体更换网段和两个静态 IP
DORIS_DOCKER_SUBNET=172.30.0.0/24

# 文件上传、质量契约和运行监督默认值
# 单个上传文件最大大小，单位为字节（1 GiB）
MAX_UPLOAD_SIZE_BYTES=1073741824
# 默认最大读取记录数
DEFAULT_MAX_INPUT_RECORDS=10000000
# 默认最大写入字节数（10 GiB）
DEFAULT_MAX_OUTPUT_BYTES=10737418240
# 默认最大执行时长，单位为秒
DEFAULT_MAX_RUNTIME_SECONDS=3600
# 默认最大输出放大比
DEFAULT_MAX_OUTPUT_AMPLIFICATION=10
# 默认最大错误拒绝率，超过后触发监督策略
DEFAULT_MAX_REJECTION_RATE=0.05
# Benchmark 数据集目录
BENCHMARK_DATASET_PATH=./benchmarks
